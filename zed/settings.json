// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "session": {
    "trust_all_worktrees": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "debugger": {
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "status_bar": {
    "cursor_position_button": true
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "low"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "fast": true,
        "effort": "low"
      },
      "type": "registry"
    }
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "disable_ai": false,
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "button": false,
    "provider": "copilot"
  },
  "proxy": "",
  "project_panel": {
    "starts_open": true,
    "git_status_indicator": true,
    "dock": "left",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "mouse_wheel_zoom": true,
  "minimap": {
    "show": "never",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_fallbacks": ["Hack Nerd Font", "Courier New"],
  "buffer_font_family": "SF Mono",
  "show_whitespaces": "all",
  "soft_wrap": "editor_width",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night"
  },
  "ui_font_size": 18.0,
  "ui_font_family": "SF Pro",
  "buffer_font_size": 19.0,
  "terminal": {
    "button": true,
    "shell": "system",
    "font_fallbacks": ["JetBrainsMono Nerd Font Mono", "Hack Nerd Font Mono"],
    "line_height": {
      "custom": 1.15,
    },
    "alternate_scroll": "off",
    "blinking": "off",
    "copy_on_select": false,
    "env": {},
    "font_family": "SF Mono",
    "font_features": null,
    "font_size": 17.0,
    "option_as_meta": false,
    "working_directory": "current_project_directory",
  },
}

